{
  "include_globs": ["**/*.md", "*.md"],
  "exclude_globs": [
    ".git/**",
    ".obsidian/**",
    ".trash/**",
    "node_modules/**",
    "agent-skills/**",
    "**/.git/**",
    "**/.obsidian/**",
    "**/.trash/**",
    "**/node_modules/**",
    "**/agent-skills/**"
  ],
  "fields": {
    "type": "type",
    "status": "status",
    "tags": "tags",
    "hubs": "moc",
    "related": "related",
    "topics": "topics",
    "created": "created",
    "updated": "updated"
  },
  "hub_detection": {
    "type_values": ["moc", "hub", "index", "map"],
    "filename_suffixes": ["MOC", "Index", "Map", "Hub"],
    "max_hubs_per_note": 3,
    "minimum_score": 2
  },
  "rules": [
    {
      "tags_any": ["example/topic"],
      "tag_prefixes": ["example/"],
      "keywords_any": ["distinctive keyword"],
      "hubs": ["Example Topic MOC"]
    }
  ],
  "related": {
    "limit": 0,
    "min_shared_tags": 1,
    "stop_tags": ["AI", "notes", "research", "general"]
  },
  "relation_section": {
    "enabled": true,
    "heading": "Related",
    "hub_label": "Hubs",
    "related_label": "Concepts"
  },
  "defaults": {
    "type": "note",
    "status": "active"
  }
}
