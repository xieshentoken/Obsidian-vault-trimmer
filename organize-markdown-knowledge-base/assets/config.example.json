{
  "profile": "auto",
  "include_globs": ["**/*.md", "*.md"],
  "exclude_globs": [
    ".git/**",
    ".obsidian/**",
    ".trash/**",
    "node_modules/**",
    "agent-skills/**",
    "**/.git/**",
    "**/.obsidian/**",
    "**/.trash/**",
    "**/node_modules/**",
    "**/agent-skills/**"
  ],
  "fields": {
    "type": "type",
    "tags": "tags",
    "aliases": "aliases",
    "hubs": "moc",
    "topics": "topics",
    "organization_status": "organization_status",
    "organization_version": "organization_version",
    "organization_hash": "organization_hash",
    "organization_candidates": "organization_candidates"
  },
  "para": {
    "inbox_names": ["Inbox"],
    "map_names": ["Map", "Maps", "MOC", "MOCs"],
    "support_names": ["Projects", "Areas", "Resources", "Archives"],
    "high_confidence": 0.85,
    "medium_confidence": 0.65
  },
  "hub_detection": {
    "type_values": ["moc", "hub", "index", "map"],
    "filename_suffixes": ["MOC", "Index", "Map", "Hub"],
    "max_hubs_per_note": 3
  },
  "matching": {
    "high_score": 70,
    "review_score": 45,
    "stop_topics": ["AI", "notes", "research", "general", "MOC", "hub", "index", "map"],
    "topic_aliases": {}
  },
  "rules": [],
  "maintenance": {
    "default_mode": "auto",
    "full_review_days": 30,
    "note_growth_count": 25,
    "note_growth_ratio": 0.1,
    "pending_inbox_count": 5
  },
  "taxonomy": {
    "enabled": true,
    "cluster_min_notes": 3,
    "broad_moc_note_limit": 80,
    "max_proposals": 10,
    "evidence_chars": 360
  },
  "state": {
    "path": ".knowledge-organizer-state.json"
  },
  "index": {
    "enabled": true,
    "path": ""
  },
  "output": {
    "max_items": 10
  }
}
